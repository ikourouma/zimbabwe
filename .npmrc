# @neondatabase/auth declares an *optional* peer on next@>=16 that conflicts with npm's strict
# resolver even though the package works fine on Next.js 15 per Neon's own docs (this repo uses
# `middleware.ts`, not `proxy.ts`, precisely because it targets Next 15 — see middleware.ts and
# PRODUCTION_MIGRATION_PLAN.md). This makes that already-intentional `--legacy-peer-deps` install
# behavior deterministic on every host (Hostinger, Vercel, CI, local `npm install`) instead of
# relying on each environment happening to pass the flag manually.
legacy-peer-deps=true
