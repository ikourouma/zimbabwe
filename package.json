    "smoke": "tsx --env-file=.env.local scripts/smoke-all-roles.ts",
    "email:test": "tsx --env-file=.env.local scripts/send-test-email.ts",
    "e2e": "tsx --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "e2e:report": "tsx node_modules/@playwright/test/cli.js show-report e2e-report"
  },
  "dependencies": {
