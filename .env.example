# Copy this file to .env.local and fill in real values there. .env.local is git-ignored —
# never commit real credentials. See PRODUCTION_MIGRATION_PLAN.md for where each value comes from.

# --- Neon Postgres (Phase 1) ---
# Neon Console → Project "zimbabwe-investment-platform" → Connect → "Pooled connection"
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Same page → "Direct connection" (no -pooler suffix) — required by Drizzle Kit migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Neon Managed Better Auth (Phase 2) ---
NEON_AUTH_BASE_URL="https://ep-sweet-paper-ainbxree.neonauth.c-4.us-east-1.aws.neon.tech/neondb/auth"
# Generate with: openssl rand -base64 32 (must be 32+ characters)
NEON_AUTH_COOKIE_SECRET=""

# --- Cloudflare R2 (Phase 4) ---
# Cloudflare dashboard → R2 → Overview → "Manage API Tokens" → Create API Token
# (Object Read & Write, scoped to the zimbabwe-investment-platform bucket)
R2_ACCOUNT_ID="86f3fdf094052c17a78dd7dc96e3382c"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="zimbabwe-investment-platform"

# --- Resend (Phase 5) ---
RESEND_API_KEY=""
# After zidaproject.com is Verified in Resend (see PRODUCTION_MIGRATION_PLAN.md)
RESEND_FROM_EMAIL="ZIDA Investment Platform <noreply@zidaproject.com>"

# --- Site config ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Neon Console → Auth: turn on "Require email verification" for public sign-up before open registration.
# This flag documents the intended production posture; the live gate is the Neon Auth setting.
REQUIRE_EMAIL_VERIFICATION="true"

# --- Database scripts (after filling DATABASE_URL* above) ---
# npm run db:migrate   # apply lib/db/migrations to Neon
# npm run db:seed      # taxonomies, projects, pilot test accounts
# npm run db:studio    # Drizzle Studio

# --- Pilot test accounts (local QA only) ---
# Optional fixed password for all 5 seeded pilot accounts at /auth/sign-in.
# When set, db:seed creates new accounts with this password and updates existing
# Neon Auth users on re-seed. When unset, each account gets a unique random password
# written to docs/PILOT_TEST_ACCOUNTS.md (git-ignored).
# PILOT_ACCOUNT_PASSWORD="your-local-pilot-password"
