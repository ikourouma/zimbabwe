# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real credentials — .env.example is the only tracked template)
.env
.env.*
!.env.example

# pilot credentials (never commit)
docs/PILOT_TEST_ACCOUNTS.md
docs/API Keys_Neon_Resend_R2.txt

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev server output redirection (npm run dev > dev_*.txt 2>&1)
dev_out*.txt
dev_err*.txt
dev_smoke.txt

# local API debug artifacts (curl cookie jars and JSON bodies)
_p8_*

# smoke test response bodies (SMOKE_DUMP=1) — may contain session-rendered markup
.smoke-dump/

# Playwright: saved sessions are live credentials; results and traces carry rendered console markup
e2e/.auth/
e2e-results/
e2e-report/

# Screenshots captured for the stakeholder walkthrough guides, and the Word files built from them —
# both are regenerated from source by the capture pass and the docs build.
docs/screenshots/
docs/build/
